# Midas Analist ortam değişkenleri.
#
# Bu dosyayı `.env` olarak kopyala ve doldur:
#     cp .env.ornek .env && chmod 600 .env
#
# .env'i CLI, sunucu ve 18:10 zamanlayıcısı OKUR. Kendi terminalinde
# `export` etmek yetmez — zamanlanmış iş senin oturumunu görmez.

# Claude API anahtarı. Yoksa sistem tam çalışır, AI katmanı kapalı kalır.
ANTHROPIC_API_KEY=

# Haberleri Claude ile de sınıflandır. 1 = açık.
# Varsayılan KAPALI: mevcut RSS kaynakları BIST şirket haberi taşımıyor,
# bu katman para harcayıp değer üretmiyor. Kaynak düzelirse aç.
MIDAS_AI_HABER=0

# Aylık AI harcama tavanı (TL). 0 = sınırsız.
MIDAS_AI_TAVAN_TL=100

# Mobil/bulut API anahtarı. Yerel ağda boş kalabilir, bulutta ZORUNLU.
MIDAS_API_ANAHTARI=

# Bulut sunucusunun SSH adresi. dagit.sh bunu okur.
# Örnek: ubuntu@140.238.12.34
MIDAS_SUNUCU=

# Telegram bildirimleri. BotFather'dan bot aç, token'ı buraya yaz.
# Sohbet kimliğini @userinfobot verir. Boşsa bildirim katmanı sessizce kapalı.
MIDAS_TELEGRAM_TOKEN=
MIDAS_TELEGRAM_SOHBET=
