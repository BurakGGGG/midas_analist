<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/portfoy_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_zemin"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PORTFÖY"
        android:textColor="@color/w_aksan"
        android:textSize="11sp"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/portfoy_deger"
        android:text="585,10 ₺"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/w_metin"
            android:textSize="20sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/portfoy_kar"
        android:text="+19,60 ₺  +3,47%"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/portfoy_alt"
        android:text="2 pozisyon · GESAN stopa %15,2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:textColor="@color/w_solgun"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/portfoy_zaman"
        android:text="14:32 itibarıyla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/w_sonuk"
        android:textSize="10sp"
        android:fontFamily="monospace" />
</LinearLayout>
