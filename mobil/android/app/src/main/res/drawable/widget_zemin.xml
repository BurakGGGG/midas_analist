<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget zemini. Uygulamanın tema kuralları burada da geçerli:
  sıfır yuvarlaklık, gölge yok, derinlik 1px kenarlıkla.
  Renkler tema.dart ile birebir aynı — ayrışırsa ana ekranda
  uygulamanın parçası gibi durmaz.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#12160F" />
    <stroke android:width="1dp" android:color="#2C3626" />
</shape>
